{
  "name": "claude-eng-framework",
  "version": "0.1.0",
  "description": "Framework d'ingénierie logicielle autonome pour Claude Code : orchestration, routage de modèles, Project Brain, garde-fous, quality gates.",
  "type": "module",
  "bin": {
    "ceng": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "core",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-reporter=spec \"dist/test/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
